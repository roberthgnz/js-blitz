{
  "name": "js-blitz",
  "productName": "js-blitz",
  "version": "0.4.0",
  "description": "Run JavaScript code in a flash",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "vue-tsc --noEmit",
    "build": "pnpm build:desktop && pnpm build:frontend",
    "build:frontend": "vite build --config vite.renderer.config.ts",
    "build:desktop": "node scripts/prepare-desktop.mjs",
    "dev:frontend": "pnpm build:desktop && vite --config vite.renderer.config.ts",
    "start": "tauri dev",
    "dev": "tauri dev",
    "tauri": "tauri",
    "package": "tauri build --no-bundle",
    "make": "tauri build",
    "check:native": "cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.3.1",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "@vue/reactivity": "^3.5.12",
    "@vue/runtime-core": "^3.5.12",
    "@vue/runtime-dom": "^3.5.12",
    "@vue/shared": "^3.5.12",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.0.1",
    "eslint-plugin-import": "^2.25.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-tailwindcss": "^3.17.5",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.14",
    "ts-node": "^10.0.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "vue-tsc": "~2.2.0",
    "vite": "^5.0.12"
  },
  "keywords": [],
  "author": {
    "name": "Roberth González",
    "email": "reliutg@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/roberthgnz/js-blitz.git"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@floating-ui/core": "^1.6.8",
    "@floating-ui/dom": "^1.6.12",
    "@floating-ui/utils": "^0.2.8",
    "@guolao/vue-monaco-editor": "^1.5.4",
    "@monaco-editor/loader": "^1.4.0",
    "@sindresorhus/merge-streams": "^4.0.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vueuse/core": "^11.2.0",
    "@vueuse/shared": "^11.2.0",
    "dayjs": "^1.11.13",
    "floating-vue": "^5.2.2",
    "monaco-editor": "0.52.2",
    "npm": "~10.9.2",
    "typescript": "~5.7.3",
    "splitpanes": "^3.1.5",
    "state-local": "^1.0.7",
    "vue": "^3.5.12",
    "vue-demi": "^0.14.10"
  }
}

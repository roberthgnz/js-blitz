{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JSBlitz",
  "version": "0.4.0",
  "identifier": "com.jsblitz.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:frontend",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JSBlitz",
        "width": 1100,
        "height": 750,
        "minWidth": 400,
        "minHeight": 300,
        "decorations": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; frame-src 'self'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/jsblitz-node"],
    "resources": {
      "resources/desktop/": "desktop/"
    },
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "category": "DeveloperTool",
    "shortDescription": "Run JavaScript and TypeScript in a flash"
  }
}
